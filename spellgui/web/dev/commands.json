        "t",
        "track"
      ],
      "title": "KeyDelArgs",
      "type": "object"
    }
  },
  {
    "doc": "Cria (sem index) ou substitui uma cue: nome, fade, wait, follow e valores DMX. Devolve o indice.",
    "name": "cue_set",
    "params": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "fade": {
          "default": 0.0,
          "description": "Segundos de fade linear ate os valores.",
          "format": "double",
          "type": "number"
        },
        "follow": {
          "default": false,
          "description": "Ao terminar, dispara a proxima.",
          "type": "boolean"
        },
        "index": {
          "default": null,
