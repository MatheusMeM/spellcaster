  {
    "doc": "Edita o show aberto por JSON Patch (RFC 6902: add, remove, replace, test). Uma op que falha cancela todas. Devolve {rev, undo}: `undo` e' a lista de ops que volta ao estado anterior, ja' na ordem de aplicacao.",
    "name": "show_patch",
    "params": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "definitions": {
        "PatchOp": {
          "properties": {
            "op": {
              "description": "add | remove | replace | test.",
              "type": "string"
            },
            "path": {
              "description": "JSON Pointer (RFC 6901) dentro do show: \"/fps\", \"/tracks/-\", \"/tracks/0/keys/2\", \"/graph/nodes\". O documento inteiro (\"\") nao e' alvo: para isso ha' show_set.",
              "type": "string"
            },
            "value": {
              "default": null,
              "description": "Valor de add, replace e test; `remove` nao usa. Ausente nos tres primeiros = erro."
            }
          },
          "required": [
            "op",
            "path"
          ],
          "type": "object"
        }
      },
      "properties": {
        "ops": {
          "description": "As operacoes, em ordem; a primeira que falhar cancela todas.",
          "items": {
            "$ref": "#/definitions/PatchOp"
          },
          "type": "array"
        },
        "rev": {
          "default": null,
          "description": "A revisao que o cliente tinha; diferente da atual = recusa (\"rev 3 != 5\").",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "ops"
      ],
      "title": "ShowPatchArgs",
      "type": "object"
    }
  },
  {
