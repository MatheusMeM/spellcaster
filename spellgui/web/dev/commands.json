          "description": "Instante em segundos.",
          "format": "double",
          "type": "number"
        },
        "track": {
          "description": "Indice do track.",
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "value": {
          "default": null,
          "description": "255, [255, 0, 0] ou texto (\"play\"); ausente = 0."
        }
      },
      "required": [
        "t",
        "track"
      ],
      "title": "KeySetArgs",
      "type": "object"
    }
