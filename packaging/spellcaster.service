[Unit]
Description=Spellcaster show control (web GUI + command registry)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/spellcaster
Environment=PYTHONPATH=/opt/spellcaster
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m spellcaster.cli serve --port 8000
Restart=on-failure
RestartSec=2
# ponytail: runs as root (systemd default) ; create a spellcaster user if the Pi stops being dedicated.
# sACN/Art-Net/OSC use ports > 1024, so there is no technical need for root.

[Install]
WantedBy=multi-user.target
