{
  "name": "laser",
  "type": "laser",
  "version": "0.1.0",
  "parameters": {
    "dev/type": { "type": "enum", "options": ["etherdream", "helios", "idn"], "default": "etherdream" },
    "dev/host": { "type": "string", "default": "" },
    "dev/pps": { "type": "int", "default": 30000, "min": 1000, "max": 100000, "norm": [10000, 40000] },
    "ilda/fps": { "type": "float", "default": 30, "min": 1, "max": 200, "norm": [20, 60] },
    "geo/x": { "type": "float", "default": 0, "min": -32767, "max": 32767, "norm": [-16000, 16000] },
    "geo/y": { "type": "float", "default": 0, "min": -32767, "max": 32767, "norm": [-16000, 16000] },
    "geo/scale": { "type": "float", "default": 1, "min": 0, "max": 4, "norm": [0, 2] },
    "geo/rot": { "type": "float", "default": 0, "min": -180, "max": 180 },
    "limit/r": { "type": "float", "default": 1, "min": 0, "max": 1 },
    "limit/g": { "type": "float", "default": 1, "min": 0, "max": 1 },
    "limit/b": { "type": "float", "default": 1, "min": 0, "max": 1 },
    "curve/r": { "type": "float", "default": 1, "min": 0.1, "max": 4 },
    "curve/g": { "type": "float", "default": 1, "min": 0.1, "max": 4 },
    "curve/b": { "type": "float", "default": 1, "min": 0.1, "max": 4 },
    "safe/min_size": { "type": "int", "default": 2000, "min": 0, "max": 32767 },
    "safe/max_intensity": { "type": "int", "default": 255, "min": 0, "max": 255 },
    "safe/zone": { "type": "float", "default": 1, "min": 0, "max": 1 },
    "safe/armed": { "type": "bool", "default": false },
    "test/pattern": { "type": "bool", "default": false }
  },
  "values": {
    "stat/fps": { "type": "float" },
    "stat/points": { "type": "int" },
    "stat/sent": { "type": "int" },
    "stat/dropped": { "type": "int" },
    "stat/errors": { "type": "int" },
    "stat/clipped": { "type": "int" }
  },
  "commands": {
    "play": { "context": "action", "args": { "file": "string" } },
    "stop": { "context": "action" },
    "shutter": { "context": "both" },
    "arm": { "context": "action" },
    "blackout": { "context": "action" }
  }
}
